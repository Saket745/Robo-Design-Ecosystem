{
  "name": "validation_agent",
  "domain": "validation",
  "capabilities": ["syntax_check", "schema_validation", "naming_compliance"],
  "constraints": {
    "isolated_execution": true,
    "domain_restriction": true,
    "unrestricted_filesystem_access": true,
    "unrestricted_network_access": false
