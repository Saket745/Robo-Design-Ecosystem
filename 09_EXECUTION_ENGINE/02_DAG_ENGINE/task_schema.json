{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Definition Schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executor": {
      "type": "string"
    },
    "params": {
      "type": "object"
    },
    "timeout": {
      "type": "integer",
      "minimum": 0
    },
    "retries": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["id", "name", "dependencies", "executor"]
}
